{
  "manifest_version": 3,
  "name": "Corrector de ortografía",
  "version": "1.6.1",
  "description": "Marca faltas de ortografía y redacción y sugiere correcciones usando LanguageTool local.",
  "host_permissions": [
    "http://localhost:8010/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "rules.js",
        "subrayado.js",
        "content.js"
      ],
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "corrector-ortografia@govannidev.cl",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_title": "Corrector de ortografía",
    "default_popup": "popup.html"
  }
}

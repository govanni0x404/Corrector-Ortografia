{
  "manifest_version": 3,
  "name": "Corrector de ortografía",
  "version": "1.1.1",
  "description": "Marca faltas de ortografía y redacción y sugiere correcciones usando LanguageTool local.",
  "host_permissions": ["http://localhost:8010/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "corrector-ortografia@example.local",
      "strict_min_version": "128.0"
    }
  }
}
